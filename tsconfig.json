{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@aniverse/types": [
        "../packages/types/src/index.ts"
      ],
      "@aniverse/api": [
        "../packages/api/src/index.ts"
      ],
      "@aniverse/playback": [
        "../packages/playback/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
