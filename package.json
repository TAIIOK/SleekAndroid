{
  "name": "aniverse-tv",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "scripts": {
    "start": "node ./scripts/with-expo-path.js expo start",
    "android": "node ./scripts/ensure-android-variant.js phone && node ./scripts/with-expo-path.js expo run:android",
    "android:phone": "node ./scripts/ensure-android-variant.js phone && node ./scripts/with-expo-path.js expo run:android",
    "ios": "node ./scripts/with-expo-path.js expo run:ios",
    "web": "node ./scripts/with-expo-path.js expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "prebuild": "node ./scripts/with-expo-path.js expo prebuild --clean",
    "prebuild:phone": "node ./scripts/with-expo-path.js expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 node ./scripts/with-expo-path.js expo prebuild --clean",
    "android:tv": "node ./scripts/ensure-android-variant.js tv && EXPO_TV=1 node ./scripts/with-expo-path.js expo run:android -d Television_1080p",
    "android:release": "NODE_ENV=production node ./scripts/with-expo-path.js ./android/gradlew -p android assembleRelease",
    "android:release:phone": "npm run prebuild:phone && npm run android:release",
    "android:release:tv": "npm run prebuild:tv && EXPO_TV=1 npm run android:release",
    "android:release:all": "node ./scripts/build-release-apks.js",
    "postinstall": "node ./scripts/link-expo-router.js && node ./scripts/patch-gradle-foojay.js",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy",
    "eas:configure": "npx eas-cli@latest update:configure",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "update:production:tv": "EXPO_TV=1 npx eas-cli@latest update --channel production-tv --environment production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:preview:tv": "EXPO_TV=1 npx eas-cli@latest update --channel preview-tv --environment preview",
    "update:all": "node ./scripts/ota-update-both.js",
    "update:all:preview": "node ./scripts/ota-update-both.js --preview"
  },
  "dependencies": {
    "@aniverse/api": "0.1.0",
    "@aniverse/catalog": "0.1.0",
    "@aniverse/playback": "0.1.0",
    "@aniverse/types": "0.1.0",
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.66.9",
    "expo": "~56.0.3",
    "expo-brightness": "~56.0.5",
    "expo-build-properties": "~56.0.13",
    "expo-constants": "~56.0.14",
    "expo-dev-client": "~56.0.14",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.8",
    "expo-intent-launcher": "~56.0.0",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.5",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.22",
    "expo-web-browser": "~56.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.85-stable",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.1",
    "react-native-video": "^6.19.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
